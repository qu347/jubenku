# Copy this file to .env.production. Do not commit the real file.
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false

DATABASE_URL=sqlite:///D:/script_material_data/database/script_materials.db
STORAGE_ROOT=D:/script_material_data/storage
LOG_DIR=D:/script_material_data/logs
BACKUP_ROOT=D:/script_material_data/backups
TEMP_ROOT=D:/script_material_data/temp

MAX_UPLOAD_MB=100
SERVE_FRONTEND=true
FRONTEND_DIST=D:/文档存储/frontend/dist

BACKUP_RETENTION_DAYS=30
CORS_ALLOWED_ORIGINS=

# SQLite is suitable for the current light, single-worker intranet deployment.
SQLITE_BUSY_TIMEOUT_MS=5000
SQLITE_WAL_ENABLED=true

# 10 MiB per file, retaining ten rotated files.
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=10
